{
  "name": "ollama-agent",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "Agentic coding CLI and shared core for Ollama local and cloud models",
  "homepage": "https://github.com/greench-ai/ollama-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greench-ai/ollama-agent.git"
  },
  "license": "MIT",
  "author": {
    "name": "greench-ai",
    "email": "greench-ai@users.noreply.github.com"
  },
  "desktopName": "ollama-agent.desktop",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "build:cli": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.mjs",
    "server": "node src/server.ts",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:start": "npm run electron:build && electron .",
    "electron:smoke": "npm run electron:build && AGENT_SMOKE=1 electron . --no-sandbox",
    "package:linux": "npm run electron:build && electron-builder --linux AppImage deb --x64",
    "release:linux": "npm run electron:build && electron-builder --linux AppImage deb --x64 --publish always",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "dev.local.ollamaagent",
    "productName": "ollama-agent",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "greench-ai",
        "repo": "ollama-agent"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "greench-ai <greench-ai@users.noreply.github.com>",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
